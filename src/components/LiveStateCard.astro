---
import CardHeading from "@/components/CardHeading.astro";
import { LiveFlow } from "@/components/live/LiveFlow";
import Panel from "@/components/ui/Panel.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import { LOAD_FAILED } from "@/lib/format/status";
import type { LiveStateView } from "@/lib/services/live-state";

interface Props {
  view: LiveStateView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
// The badge says how fresh the reading is (or why there is none); the notices below only add what it can't.
const status = view === null ? LOAD_FAILED : view.status;
---

<Panel>
  <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    <CardHeading title="Stan na żywo" size="lg" />
    <StatusBadge status={status} testId="live-status" dot />
  </div>

  {view === null && <p class="text-muted-foreground text-sm">Spróbuj odświeżyć stronę.</p>}

  {view?.kind === "state" && (
    <div class="space-y-4">
      {view.isDegraded && (
        <p class="text-muted-foreground text-sm">Część odczytów z Home Assistant może być niedostępna.</p>
      )}
      {view.isStale && (
        <p class="text-muted-foreground text-sm">
          Ruch i oceny wstrzymane: odczyty starsze niż 15 minut nie opisują stanu teraz.
        </p>
      )}

      <LiveFlow
        client:load
        pv={view.pv}
        homeLoad={view.homeLoad}
        grid={view.grid}
        battery={view.battery}
        flows={view.flows}
        verdicts={view.verdicts}
        capturedAtLabel={view.capturedAtLabel}
        ageLabel={view.ageLabel}
        isStale={view.isStale}
      />

      <div class="bg-muted space-y-2 rounded-lg p-3 text-sm">
        <p class="text-muted-foreground text-xs" data-testid="live-today-period">
          {view.today.periodLabel.charAt(0).toUpperCase() + view.today.periodLabel.slice(1)}
        </p>
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          <div>
            <dt class="text-muted-foreground">Z paneli dziś</dt>
            <dd class="font-medium">{view.today.pv}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Kupione z sieci dziś</dt>
            <dd class="font-medium">{view.today.bought}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Sprzedane do sieci dziś</dt>
            <dd class="font-medium">{view.today.sold}</dd>
          </div>
        </dl>
      </div>

      <p class="text-muted-foreground text-xs">Odczyt z {view.capturedAtLabel}</p>

      <TermsExplained terms={["pv", "kw", "kwh", "battery_soc", "grid_import", "grid_export"]} />
    </div>
  )}
</Panel>
