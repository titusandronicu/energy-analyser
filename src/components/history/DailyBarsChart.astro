---
// Server-rendered daily bars for a month (history calendar): one bar per calendar day on a zero baseline, with an
// optional line on the same scale. No script and no library. Missing days are empty slots, never zero bars. The chart
// sits on its own opaque bg-inset surface, as the flow colours are only checked against bg-card and bg-inset.
import { cn } from "@/lib/utils";
import { barGeometry, dayTicks, describeBars, slotCenter } from "@/lib/bars";
import { oneDecimal } from "@/lib/format/values";
import { formatDayMonth } from "@/lib/format/warsaw-time";

interface Props {
  bars: readonly (number | null)[];
  line?: readonly (number | null)[];
  // The day keys of the slots, oldest first, the same length as `bars`: tick labels and the accessible label.
  days: readonly string[];
  subject: string;
  windowLabel: string;
  barTone: "pv" | "grid";
  lineTone?: "home";
  class?: string;
}

const { bars, line, days, subject, windowLabel, barTone, lineTone = "home", class: className } = Astro.props;

// Full class names, so Tailwind sees every one of them.
const FILL_CLASS = { pv: "fill-flow-pv", grid: "fill-flow-grid" } as const;
const SWATCH_CLASS = { pv: "bg-flow-pv", grid: "bg-flow-grid", home: "bg-flow-home" } as const;
const STROKE_CLASS = { home: "stroke-flow-home" } as const;
const LINE_WORD = { home: "Zużycie domu" } as const;

// One 10-unit slot per day; the SVG stretches to the card width at a fixed height, so tick text stays HTML.
const SLOT = 10;
const HEIGHT = 100;
const width = Math.max(1, bars.length) * SLOT;
const geometry = barGeometry([bars], { width, height: HEIGHT, gap: 3, lineSeries: line });

const slotLabels = days.map((day) => formatDayMonth(day));
const labels = [
  describeBars(subject, windowLabel, bars, "kWh", { slotLabels }),
  line === undefined ? null : describeBars(LINE_WORD[lineTone], windowLabel, line, "kWh", { slotLabels }),
].filter((part): part is string => part !== null);
const ticks = dayTicks(bars.length).map((slot) => ({
  slot,
  text: String(Number(days.at(slot)?.slice(8, 10) ?? slot + 1)),
  left: (slotCenter(slot, bars.length, width) / width) * 100,
}));
---

<div class:list={cn("bg-inset rounded-md p-3", className)}>
  {geometry === null ? (
    <p class="text-muted-foreground text-xs" data-testid="bars-empty">
      za mało dni
    </p>
  ) : (
    <div class="flex flex-col gap-2">
      <ul class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
        <li class="inline-flex items-center gap-1.5">
          <span class:list={cn("inline-block size-2.5 rounded-sm", SWATCH_CLASS[barTone])} aria-hidden="true" />
          {subject}
        </li>
        {line !== undefined && (
          <li class="inline-flex items-center gap-1.5">
            <span class:list={cn("inline-block h-0.5 w-3 rounded-full", SWATCH_CLASS[lineTone])} aria-hidden="true" />
            {LINE_WORD[lineTone]}
          </li>
        )}
        <li class="ml-auto tabular-nums">skala 0–{oneDecimal.format(geometry.max)} kWh</li>
      </ul>
      <svg
        viewBox={`0 0 ${String(width)} ${String(HEIGHT)}`}
        preserveAspectRatio="none"
        role="img"
        aria-label={labels.join("; ")}
        class="block h-28 w-full"
      >
        <line
          x1="0"
          y1={HEIGHT}
          x2={width}
          y2={HEIGHT}
          class="stroke-border"
          stroke-width="1"
          vector-effect="non-scaling-stroke"
        />
        {geometry.bars.map((bar) => (
          <rect x={bar.x} y={bar.y} width={bar.w} height={bar.h} rx="1" class:list={FILL_CLASS[barTone]} />
        ))}
        {geometry.line !== null && (
          <path
            d={geometry.line}
            fill="none"
            class:list={STROKE_CLASS[lineTone]}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
        )}
      </svg>
      <div class="text-muted-foreground relative h-4 text-[11px] tabular-nums" aria-hidden="true">
        {ticks.map((tick) => (
          <span class="absolute top-0 -translate-x-1/2" style={`left: ${tick.left.toFixed(2)}%`}>
            {tick.text}
          </span>
        ))}
      </div>
    </div>
  )}
</div>
