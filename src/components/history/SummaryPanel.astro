---
import { FileText } from "lucide-react";
import CardHeading from "@/components/CardHeading.astro";
import Panel from "@/components/ui/Panel.astro";
import type { SummaryView } from "@/lib/services/period-summary";

interface Props {
  title: string;
  summary: SummaryView;
  testId: string;
}

// The lab's plain-language text for a completed day or month (S-18). The text is untrusted, so it renders as escaped
// text, never as HTML. A period the lab has facts for but no text yet says so in one sentence and shows no figures. No
// client JavaScript.
const { title, summary, testId } = Astro.props;
---

<Panel>
  <div data-testid={testId}>
    <CardHeading class="mb-2" title={title} icon={FileText} iconClass="text-primary" />
    {summary.kind === "narrated" ? (
      <div class="space-y-1">
        <p class="text-card-foreground leading-relaxed whitespace-pre-line [overflow-wrap:anywhere]">{summary.text}</p>
        <p class="text-muted-foreground text-xs">
          napisane {summary.generatedAtLabel} · dotyczy: {summary.periodLabel}
        </p>
      </div>
    ) : (
      <div class="space-y-1">
        <p class="text-muted-foreground text-sm">Opis jeszcze się nie pojawił.</p>
        <p class="text-muted-foreground text-xs">Dotyczy: {summary.periodLabel}</p>
      </div>
    )}
  </div>
</Panel>
