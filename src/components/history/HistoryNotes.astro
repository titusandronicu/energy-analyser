---
import { GLOSSARY, type GlossaryTerm } from "@/lib/format/glossary";
import {
  FORECAST_EXPLANATION,
  GRID_IMPORT_EXPLANATION,
  GRID_IMPORT_TERM,
  TOO_FEW_EXPLANATION,
} from "@/lib/services/calendar-view";

// The history page's "Co to znaczy?": the terms its figures use, and why some figures are missing or shown with a
// caveat. A native <details>, so it works without a script; py-1 keeps the summary's tap target at least 24 px tall.
const TERMS: GlossaryTerm[] = ["pv", "house_use", "grid_import", "forecast", "kwh"];
const NOTES = [
  {
    term: "Pełny dzień",
    explanation:
      "Dzień, który już minął i ma zapisaną produkcję z paneli, zużycie domu i prąd kupiony z sieci. Sumy liczą tylko pełne dni i mówią, z ilu dni są. Dzisiejszy dzień jeszcze trwa, więc nigdy nie jest liczony jako pełny.",
  },
  {
    term: "Puste dni",
    explanation:
      "Dni, z których aplikacja nie dostała danych albo dostała niepełne, zostają puste: na wykresie nie mają słupka, w sumach się nie liczą. Nie wpisujemy za nie zera ani szacunku.",
  },
  { term: "Za mało danych", explanation: TOO_FEW_EXPLANATION },
  { term: GRID_IMPORT_TERM, explanation: GRID_IMPORT_EXPLANATION },
  {
    term: "Dlaczego nie ma prądu sprzedanego do sieci",
    explanation:
      "Licznik falownika pokazuje za mało prądu oddanego do sieci, a od połowy sierpnia pokazuje zero, choć PGE zapisało prawdziwy zwrot. Dlatego kalendarz go nie pokazuje.",
  },
  { term: "Prognoza a rzeczywistość", explanation: FORECAST_EXPLANATION },
];
---

<details class="text-muted-foreground text-sm">
  <summary class="text-card-foreground cursor-pointer py-1">Co to znaczy?</summary>
  <dl class="mt-2 space-y-2">
    {TERMS.map((key) => (
      <div>
        <dt class="text-card-foreground font-medium">{GLOSSARY[key].term}</dt>
        <dd>{GLOSSARY[key].explanation}</dd>
      </div>
    ))}
    {NOTES.map(({ term, explanation }) => (
      <div>
        <dt class="text-card-foreground font-medium">{term}</dt>
        <dd>{explanation}</dd>
      </div>
    ))}
  </dl>
</details>
