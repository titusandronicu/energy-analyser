---
import Panel from "@/components/ui/Panel.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import { DisclosureButton } from "@/components/ui/DisclosureButton";
import type { RecommendationView } from "@/lib/services/recommendation";
import { parseAdviceMarkdown } from "@/lib/format/advice-markdown";
import { LOAD_FAILED } from "@/lib/format/status";

interface Props {
  view: RecommendationView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
const status = view === null ? LOAD_FAILED : view.status;
---

<Panel>
  <h2 class="mb-2 text-lg font-semibold text-blue-100">Rekomendacja na dziś</h2>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <StatusBadge status={status} testId="recommendation-status" />
    {view?.kind === "recommendation" && (
      <span class="text-xs text-blue-100/70">Wygenerowano {view.generatedAtLabel}</span>
    )}
  </div>

  {view === null && <p class="text-sm text-blue-100/70">Spróbuj odświeżyć stronę.</p>}

  {view?.kind === "recommendation" && (
    <div class="space-y-4">
      {view.isStale && (
        <p class="text-sm text-blue-100/70" data-testid="stale-warning">
          Laboratorium mogło przestać przesyłać dane.
        </p>
      )}

      <div class="space-y-3 leading-relaxed" data-testid="recommendation-text">
        {parseAdviceMarkdown(view.text).map((block) =>
          block.type === "paragraph" ? (
            <p>
              {block.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}
                </>
              ))}
            </p>
          ) : block.ordered ? (
            <ol class="list-decimal space-y-1 pl-5">
              {block.items.map((item) => (
                <li>{item.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}</li>
              ))}
            </ol>
          ) : (
            <ul class="list-disc space-y-1 pl-5">
              {block.items.map((item) => (
                <li>{item.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}</li>
              ))}
            </ul>
          ),
        )}
      </div>

      <DisclosureButton
        client:load
        openLabel="Pokaż szczegóły"
        closeLabel="Ukryj szczegóły"
        controlsId="recommendation-details"
      >
        {view.findings.length > 0 && (
          <>
            <p class="mt-2 text-xs font-medium text-blue-100">Na podstawie</p>
            <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-blue-100/80">
              {view.findings.map((finding) => (
                <li>{finding}</li>
              ))}
            </ul>
          </>
        )}
        <p class="mt-2 text-xs text-blue-100/70">{view.modelLabel}</p>
      </DisclosureButton>
    </div>
  )}

  <p class="mt-4 text-xs text-blue-100/70">
    To tylko porada. Aplikacja niczego nie zmienia w falowniku ani w Home Assistant.
  </p>
</Panel>
