---
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import type { RecommendationView } from "@/lib/services/recommendation";
import { parseAdviceMarkdown } from "@/lib/format/advice-markdown";
import { LOAD_FAILED } from "@/lib/format/status";

interface Props {
  view: RecommendationView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
const status = view === null ? LOAD_FAILED : view.status;
// Advice from an earlier day names its forecast days by date only: "dziś"/"jutro" would be wrong.
const fromEarlierDay = view?.kind === "recommendation" && view.isFromEarlierDay;
---

<section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
  <h2 class="mb-2 text-lg font-semibold text-blue-100">Rekomendacja na dziś</h2>
  <div class="mb-4">
    <StatusBadge status={status} testId="recommendation-status" />
  </div>

  {view === null && <p class="text-sm text-blue-100/70">Spróbuj odświeżyć stronę.</p>}

  {view?.kind === "recommendation" && (
    <div class="space-y-4">
      {view.isStale && (
        <p class="text-sm text-blue-100/70" data-testid="stale-warning">
          Laboratorium mogło przestać przesyłać dane.
        </p>
      )}

      <div class="space-y-3 leading-relaxed" data-testid="recommendation-text">
        {parseAdviceMarkdown(view.text).map((block) =>
          block.type === "paragraph" ? (
            <p>
              {block.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}
                </>
              ))}
            </p>
          ) : block.ordered ? (
            <ol class="list-decimal space-y-1 pl-5">
              {block.items.map((item) => (
                <li>{item.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}</li>
              ))}
            </ol>
          ) : (
            <ul class="list-disc space-y-1 pl-5">
              {block.items.map((item) => (
                <li>{item.map((segment) => (segment.bold ? <strong>{segment.text}</strong> : segment.text))}</li>
              ))}
            </ul>
          ),
        )}
      </div>

      <dl class="grid grid-cols-1 gap-3 rounded-lg bg-white/5 p-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-blue-100/60">
            {fromEarlierDay
              ? `Prognoza produkcji z paneli — ${view.forecast.todayDayLabel}`
              : `Prognoza produkcji z paneli — dziś (${view.forecast.todayDayLabel})`}
          </dt>
          <dd class="font-medium">{view.forecast.todayLabel}</dd>
        </div>
        <div>
          <dt class="text-blue-100/60">
            {fromEarlierDay
              ? `Prognoza produkcji z paneli — ${view.forecast.tomorrowDayLabel}`
              : `Prognoza produkcji z paneli — jutro (${view.forecast.tomorrowDayLabel})`}
          </dt>
          <dd class="font-medium">{view.forecast.tomorrowLabel}</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-blue-100/60">Pewność prognozy</dt>
          <dd class="mt-1">
            <StatusBadge status={view.forecast.certainty} testId="forecast-certainty" />
          </dd>
        </div>
      </dl>

      {view.findings.length > 0 && (
        <details class="text-sm text-blue-100/80">
          <summary class="cursor-pointer py-1 text-blue-100">Na podstawie</summary>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {view.findings.map((finding) => (
              <li>{finding}</li>
            ))}
          </ul>
        </details>
      )}

      <p class="text-xs text-blue-100/70">
        Wygenerowano {view.generatedAtLabel} · {view.modelLabel}
      </p>

      <TermsExplained terms={["forecast", "forecast_certainty", "kwh"]} />
    </div>
  )}

  <p class="mt-4 text-xs text-blue-100/70">
    To tylko porada. Aplikacja niczego nie zmienia w falowniku ani w Home Assistant.
  </p>
</section>
