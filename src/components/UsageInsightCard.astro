---
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import { GLOSSARY } from "@/lib/format/glossary";
import { LOAD_FAILED } from "@/lib/format/status";
import type { UsageInsightView } from "@/lib/services/usage-insight";
import { cn } from "@/lib/utils";

interface Props {
  view: UsageInsightView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
// "Yesterday" only when the compared day is yesterday; the error and insufficient states keep it too.
const heading = view?.kind === "insight" && !view.isYesterday ? "Zużycie dzienne" : "Zużycie wczoraj";
const status = view === null ? LOAD_FAILED : view.status;
// "prąd, który …": the glossary sentence continues the "Kupione z sieci:" label, so it starts in lower case.
const purchaseExplanation =
  GLOSSARY.grid_import.explanation.charAt(0).toLowerCase() + GLOSSARY.grid_import.explanation.slice(1);
---

<section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
  <h2 class="mb-2 text-lg font-semibold text-blue-100">{heading}</h2>
  <div class="mb-4">
    <StatusBadge status={status} testId="usage-status" />
  </div>

  {view === null && <p class="text-sm text-blue-100/70">Spróbuj odświeżyć stronę.</p>}

  {view?.kind === "insufficient" && (
    <p class="text-sm text-blue-100/70" data-testid="usage-insufficient-reason">
      {view.reason.charAt(0).toUpperCase() + view.reason.slice(1)}.
    </p>
  )}

  {view?.kind === "insight" && (
    <div class="space-y-4">
      <p class="text-sm text-blue-100/80">
        {view.isYesterday ? `Wczoraj (${view.dayLabel})` : view.dayLabel}
        {!view.isYesterday && <span class="text-blue-100/60"> — brak danych z wczoraj.</span>}
      </p>

      <dl class="grid grid-cols-2 gap-3 text-sm">
        <div class="rounded-lg bg-white/5 p-3">
          <dt class="text-blue-100/60">Zużycie domu</dt>
          <dd class="text-lg font-medium">{view.load.kwhLabel}</dd>
          <dd class="mt-1 text-xs text-blue-100/70">{view.load.deltaLabel} wobec normy</dd>
        </div>
        <div class="rounded-lg bg-white/5 p-3">
          <dt class="text-blue-100/60">Kupione z sieci</dt>
          <dd class="text-lg font-medium">{view.purchase.kwhLabel}</dd>
          <dd class="mt-1 text-xs text-blue-100/70">{view.purchase.deltaLabel} wobec normy</dd>
        </div>
      </dl>

      {view.baseline.kind === "seasonal" ? (
        <p class="text-xs text-blue-100/60" data-testid="usage-baseline">
          Norma: ta sama pora roku, mediana z {view.baseline.periodLabel}.
        </p>
      ) : (
        <p class="text-xs text-blue-100/60" data-testid="usage-fallback-notice">
          Norma: mediana z {view.baseline.periodLabel}. Z tej pory roku jest jeszcze za mało danych, więc porównujemy z
          ostatnimi dniami.
        </p>
      )}

      {view.meaning === null ? (
        <TermsExplained terms={["kwh", "norm", "grid_import"]} />
      ) : (
        <details class="text-sm text-blue-100/80" data-testid="usage-meaning">
          <summary class="cursor-pointer py-1 text-blue-100">Co to znaczy?</summary>
          <div class="mt-2 space-y-3">
            <p>
              {view.isYesterday ? "Wczoraj" : view.dayLabel} dom zużył <strong>{view.load.kwhLabel}</strong> prądu.
              Zwykle zużywa <strong>{view.meaning.normKwhLabel}</strong> dziennie — to mediana z{" "}
              {view.baseline.periodLabel}, czyli w połowie tych dni zużycie było niższe, a w połowie wyższe.
            </p>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1" data-testid="usage-ranges">
              {view.meaning.ranges.map((range) => {
                const current = range.band === view.meaning?.band;
                return (
                  <div class:list={cn("contents", current ? "font-semibold text-white" : "text-blue-100/70")}>
                    <dt>{range.name}</dt>
                    <dd>
                      {range.label}
                      {current && (
                        <span class="font-normal text-blue-100/80">
                          {" "}
                          <span aria-hidden="true">←</span> ten dzień
                        </span>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
            <p data-testid="usage-verdict">{view.meaning.verdictSentence}</p>
            <p class="text-blue-100/70">
              <span class="text-blue-100">Kupione z sieci:</span> {purchaseExplanation}
            </p>
            <p class="text-xs text-blue-100/60" data-testid="usage-reference">
              {view.meaning.referenceSentence}
            </p>
          </div>
        </details>
      )}
    </div>
  )}
</section>
