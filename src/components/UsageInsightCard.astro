---
import RefreshHint from "@/components/ui/RefreshHint.astro";
import { House } from "lucide-react";
import CardHeading from "@/components/CardHeading.astro";
import Panel from "@/components/ui/Panel.astro";
import Sparkline from "@/components/ui/Sparkline.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import { GLOSSARY } from "@/lib/format/glossary";
import { LOAD_FAILED } from "@/lib/format/status";
import { sentence } from "@/lib/services/calendar-view";
import { SENSOR_CAVEAT, SENSOR_CHANGE_BASELINE_NOTE } from "@/lib/services/grid-sensor";
import type { UsageInsightView } from "@/lib/services/usage-insight";
import { cn } from "@/lib/utils";

interface Props {
  view: UsageInsightView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
// "Yesterday" only when the compared day is yesterday; the error and insufficient states keep it too.
const heading = view?.kind === "insight" && !view.isYesterday ? "Zużycie dzienne" : "Zużycie wczoraj";
const status = view === null ? LOAD_FAILED : view.status;
// "prąd, który …": the glossary sentence continues the "Kupione z sieci:" label, so it starts in lower case.
const purchaseExplanation =
  GLOSSARY.grid_import.explanation.charAt(0).toLowerCase() + GLOSSARY.grid_import.explanation.slice(1);

// The two rows of the compared day, each with the 7 days ending on it. The series come with the "insight" view, which
// only exists when the rows loaded, so there is no "historia niedostępna" variant here.
const rows =
  view?.kind === "insight"
    ? [
        {
          label: "Zużycie domu",
          value: view.load.kwhLabel,
          delta: view.load.deltaLabel,
          series: view.series.load,
          subject: "Zużycie domu",
          tone: "home" as const,
        },
        {
          label: "Kupione z sieci",
          value: view.purchase.kwhLabel,
          delta: view.purchase.deltaLabel,
          series: view.series.purchase,
          subject: "Energia kupiona z sieci",
          tone: "neutral" as const,
        },
      ]
    : [];
---

<Panel>
  <CardHeading class="mb-2" title={heading} icon={House} iconClass="text-flow-home" />
  <div class="mb-4">
    <StatusBadge status={status} testId="usage-status" />
  </div>

  {view === null && <RefreshHint />}

  {view?.kind === "insufficient" && (
    <p class="text-muted-foreground text-sm" data-testid="usage-insufficient-reason">
      {sentence(view.reason)}
    </p>
  )}

  {view?.kind === "insight" && (
    <div class="space-y-4">
      <p class="text-muted-foreground text-sm">
        {view.isYesterday ? `Wczoraj (${view.dayLabel})` : view.dayLabel}
        {!view.isYesterday && <span class="text-muted-foreground/75"> — brak danych z wczoraj.</span>}
      </p>

      <ul class="divide-hairline divide-y">
        {rows.map(({ label, value, delta, series, subject, tone }) => (
          <li class="flex items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
            <div class="flex min-w-0 flex-col gap-0.5">
              <span class="text-muted-foreground text-[13px]">{label}</span>
              <span class="text-[19px] font-bold sm:text-xl">{value}</span>
              <span class="text-muted-foreground text-xs">{delta} wobec normy</span>
            </div>
            <div class="w-[100px] flex-none sm:w-[110px]">
              <Sparkline
                values={series}
                subject={subject}
                windowLabel={`7 dni do ${view.dayLabel}`}
                tone={tone}
                width={110}
                height={32}
                class="h-auto w-[100px] sm:w-[110px]"
              />
            </div>
          </li>
        ))}
      </ul>

      {view.baseline.kind === "seasonal" ? (
        <p class="text-muted-foreground text-xs" data-testid="usage-baseline">
          Norma: ta sama pora roku, mediana z {view.baseline.periodLabel}.
        </p>
      ) : (
        <p class="text-muted-foreground text-xs" data-testid="usage-fallback-notice">
          Norma: mediana z {view.baseline.periodLabel}. Z tej pory roku jest jeszcze za mało danych, więc porównujemy z
          ostatnimi dniami.
        </p>
      )}

      {view.baseline.crossesSensorChange && (
        <p class="text-muted-foreground text-xs" data-testid="usage-baseline-sensor-note">
          {SENSOR_CHANGE_BASELINE_NOTE}
        </p>
      )}
      <p class="text-muted-foreground text-xs" data-testid="usage-sensor-caveat">
        {SENSOR_CAVEAT}
      </p>

      {view.meaning === null ? (
        <TermsExplained terms={["kwh", "norm", "grid_import"]} />
      ) : (
        <details class="text-muted-foreground text-sm" data-testid="usage-meaning">
          <summary class="text-card-foreground cursor-pointer py-1">Co to znaczy?</summary>
          <div class="mt-2 space-y-3">
            <p>
              {view.isYesterday ? "Wczoraj" : view.dayLabel} dom zużył <strong>{view.load.kwhLabel}</strong> prądu.
              Zwykle zużywa <strong>{view.meaning.normKwhLabel}</strong> dziennie — to mediana z{" "}
              {view.baseline.periodLabel}, czyli w połowie tych dni zużycie było niższe, a w połowie wyższe.
            </p>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1" data-testid="usage-ranges">
              {view.meaning.ranges.map((range) => {
                const current = range.band === view.meaning?.band;
                return (
                  <div
                    class:list={cn(
                      "contents",
                      current ? "text-card-foreground font-semibold" : "text-muted-foreground",
                    )}
                  >
                    <dt>{range.name}</dt>
                    <dd>
                      {range.label}
                      {current && (
                        <span class="text-muted-foreground font-normal">
                          {" "}
                          <span aria-hidden="true">←</span> ten dzień
                        </span>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
            <p data-testid="usage-verdict">{view.meaning.verdictSentence}</p>
            <p class="text-muted-foreground">
              <span class="text-card-foreground">Kupione z sieci:</span> {purchaseExplanation}
            </p>
            <p class="text-muted-foreground text-xs" data-testid="usage-reference">
              {view.meaning.referenceSentence}
            </p>
          </div>
        </details>
      )}
    </div>
  )}
</Panel>
