---
import { statusText, type Status, type StatusTone } from "@/lib/format/status";
import { cn } from "@/lib/utils";

interface Props {
  status: Status;
  testId?: string;
}

const { status, testId } = Astro.props;

// The text carries the meaning; the colour only supports it.
const TONE_CLASSES: Record<StatusTone, string> = {
  good: "border-emerald-400/40 bg-emerald-900/30 text-emerald-200",
  watch: "border-amber-400/40 bg-amber-900/30 text-amber-200",
  problem: "border-red-500/40 bg-red-900/30 text-red-300",
  insufficient: "border-white/15 bg-white/10 text-blue-100",
};
---

<span
  class:list={cn(
    "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium",
    TONE_CLASSES[status.tone],
  )}
  data-tone={status.tone}
  data-testid={testId}
>
  {statusText(status)}
</span>
