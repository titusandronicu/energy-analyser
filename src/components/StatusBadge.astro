---
import { statusText, type Status } from "@/lib/format/status";
import { TONE_CLASSES } from "@/lib/format/tone-classes";
import { cn } from "@/lib/utils";

interface Props {
  status: Status;
  testId?: string;
  dot?: boolean;
  // Replaces the "<word> · <detail>" text, for a card that rates nothing: its badge keeps the tone's colour and
  // says in its own words what the figures rest on ("Pełne dane z 30 dni").
  text?: string;
}

const { status, testId, dot = false, text } = Astro.props;
---

<span
  class:list={cn(
    "inline-flex items-center rounded-2xl border px-2.5 py-0.5 text-xs font-medium",
    dot && "gap-1.5",
    TONE_CLASSES[status.tone],
  )}
  data-tone={status.tone}
  data-testid={testId}
>
  {dot && <span aria-hidden="true" class="size-2 rounded-full bg-current" />}
  {text ?? statusText(status)}
</span>
