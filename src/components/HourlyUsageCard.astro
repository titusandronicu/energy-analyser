---
import RefreshHint from "@/components/ui/RefreshHint.astro";
import { Clock } from "lucide-react";
import CardHeading from "@/components/CardHeading.astro";
import Panel from "@/components/ui/Panel.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import { LOAD_FAILED, NO_STATUS } from "@/lib/format/status";
import { SENSOR_CAVEAT } from "@/lib/services/grid-sensor";
import { sentence } from "@/lib/services/calendar-view";
import type { HourlyUsageView, RankedDay, RankedHour, Ranking } from "@/lib/services/hourly-usage";

interface Props {
  view: HourlyUsageView | null;
}

// null means loading failed; the page never throws a 500 for a data problem.
const { view } = Astro.props;
const usage = view?.kind === "usage" ? view : null;

// The card rates nothing, so its data badge is the neutral tone and says what the figures rest on rather than
// borrowing "za mało danych"; the empty and failed states keep their usual status.
const status = view === null ? LOAD_FAILED : view.kind === "empty" ? view.status : NO_STATUS;
const completeDays = usage?.window.completeDays ?? 0;
const badgeText =
  usage === null
    ? undefined
    : completeDays === 0
      ? "Dane bez pełnego dnia"
      : `Pełne dane z ${String(completeDays)} ${completeDays === 1 ? "dnia" : "dni"}`;

// Why the lists rank by house use and leave some hours out; it follows the sensor caveat in the footer.
const RANKING_NOTE =
  "Godziny i dni są uszeregowane według zużycia domu, a godziny, w których pobór z sieci wyraźnie przewyższa zużycie domu, nie trafiają na listę najniższych.";

// Both lists of a ranking, highest first; each list names its own direction for a screen reader.
function lists<T>(ranking: Ranking<T>) {
  return ranking.kind === "ranked"
    ? [
        { title: "Najwyższe", items: ranking.highest },
        { title: "Najniższe", items: ranking.lowest },
      ]
    : [];
}
const hourLists: { title: string; items: RankedHour[] }[] = usage === null ? [] : lists(usage.hours);
const dayLists: { title: string; items: RankedDay[] }[] = usage === null ? [] : lists(usage.days);
---

<Panel>
  <CardHeading class="mb-2" title="Godziny zużycia" icon={Clock} iconClass="text-flow-home" />
  <div class="mb-4">
    <StatusBadge status={status} text={badgeText} testId="hourly-status" />
  </div>

  {view === null && <RefreshHint />}

  {view?.kind === "empty" && (
    <p class="text-muted-foreground text-sm" data-testid="hourly-empty-reason">
      {sentence(view.reason)}
    </p>
  )}

  {usage !== null && (
    <div class="space-y-6">
      <dl class="bg-muted grid grid-cols-1 gap-3 rounded-lg p-3 text-sm sm:grid-cols-2" data-testid="hourly-nights">
        <div>
          <dt class="text-muted-foreground">Pobór z sieci ostatniej nocy (22:00–6:00)</dt>
          {usage.lastNight.complete ? (
            <dd class="mt-1">
              <span class="block text-[19px] font-bold sm:text-xl">{usage.lastNight.gridDrawLabel}</span>
              <span class="text-muted-foreground text-xs">{usage.lastNight.label}</span>
            </dd>
          ) : (
            <dd class="text-muted-foreground mt-1">{sentence(usage.lastNight.reason)}</dd>
          )}
        </div>
        <div>
          <dt class="text-muted-foreground">Średnio na noc</dt>
          {usage.nightAverage === null ? (
            <dd class="text-muted-foreground mt-1">Brak pełnej nocy w tym okresie.</dd>
          ) : (
            <dd class="mt-1">
              <span class="block text-[19px] font-bold sm:text-xl">{usage.nightAverage.gridDrawLabel}</span>
              <span class="text-muted-foreground text-xs">
                {`średnia z ${String(usage.nightAverage.nights)} ${usage.nightAverage.nights === 1 ? "pełnej nocy" : "pełnych nocy"}`}
              </span>
            </dd>
          )}
        </div>
      </dl>

      <section aria-labelledby="hourly-hours-heading" data-testid="hourly-hours">
        <h3 id="hourly-hours-heading" class="text-card-foreground text-base font-semibold">
          Godziny z największym i najmniejszym zużyciem domu
        </h3>
        {usage.hours.kind === "insufficient" ? (
          <p class="text-muted-foreground mt-2 text-sm">{sentence(usage.hours.reason)}</p>
        ) : (
          <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {hourLists.map(({ title, items }) => (
              <div>
                <h4 class="text-muted-foreground text-[13px] font-medium">{title}</h4>
                <ol class="divide-hairline mt-1 divide-y text-sm">
                  {items.map((hour) => (
                    <li class="flex items-start justify-between gap-3 py-2">
                      <div class="min-w-0">
                        <span class="block font-medium">{hour.hourLabel}</span>
                        <span class="text-muted-foreground text-xs">{`${hour.dayLabel}, ${hour.weekday}`}</span>
                      </div>
                      <div class="flex-none text-right">
                        <span class="block">
                          <span class="text-muted-foreground text-xs">dom </span>
                          <span class="font-semibold">{hour.loadLabel}</span>
                        </span>
                        <span class="text-muted-foreground text-xs">{`z sieci ${hour.gridDrawLabel}`}</span>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        )}
      </section>

      <section aria-labelledby="hourly-days-heading" data-testid="hourly-days">
        <h3 id="hourly-days-heading" class="text-card-foreground text-base font-semibold">
          Dni z największym i najmniejszym zużyciem domu
        </h3>
        {usage.days.kind === "insufficient" ? (
          <p class="text-muted-foreground mt-2 text-sm">{sentence(usage.days.reason)}</p>
        ) : (
          <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {dayLists.map(({ title, items }) => (
              <div>
                <h4 class="text-muted-foreground text-[13px] font-medium">{title}</h4>
                <ol class="divide-hairline mt-1 divide-y text-sm">
                  {items.map((day) => (
                    <li class="flex items-baseline justify-between gap-3 py-2">
                      <span class="min-w-0">
                        <span class="font-medium">{day.dayLabel}</span>
                        <span class="text-muted-foreground text-xs">{`, ${day.weekday}`}</span>
                      </span>
                      <span class="flex-none font-semibold">{day.loadLabel}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        )}
      </section>

      <div class="text-muted-foreground space-y-2 text-xs" data-testid="hourly-window">
        <p>{`Okres danych — ${usage.window.label}. ${usage.window.completenessRule}`}</p>
        <p class="border-hairline border-l-2 pl-3" data-testid="hourly-caveat">
          {`${SENSOR_CAVEAT} ${RANKING_NOTE}`}
        </p>
      </div>

      <TermsExplained terms={["house_use", "night_grid_draw", "kwh"]} />
    </div>
  )}
</Panel>
