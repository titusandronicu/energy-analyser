---
import { FileText } from "lucide-react";
import CardHeading from "@/components/CardHeading.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import SummaryText from "@/components/SummaryText.astro";
import Panel from "@/components/ui/Panel.astro";
import { todaySummaryStatus, type TodaySummaryView } from "@/lib/services/period-summary";

interface Props {
  view: TodaySummaryView | null;
}

// The lab's plain-language explanation of today's figures (S-18). null means loading failed; the page never throws a
// 500 for a data problem. The body is the shared SummaryText fragment.
const { view } = Astro.props;
const status = todaySummaryStatus(view);
---

<Panel>
  <div data-testid="today-summary">
    <CardHeading
      class="mb-2"
      title="Co oznaczają dzisiejsze liczby"
      size="lead"
      icon={FileText}
      iconClass="text-primary"
    />
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <StatusBadge status={status} testId="today-summary-status" />
      {view?.kind === "narrated" && (
        <span class="text-xs text-muted-foreground">Wygenerowano {view.generatedAtLabel}</span>
      )}
    </div>

    {view === null && <p class="text-sm text-muted-foreground">Spróbuj odświeżyć stronę.</p>}

    {view?.kind === "narrated" && <SummaryText text={view.text} meta={`Dotyczy: ${view.periodLabel}`} />}

    {view?.kind === "pending" && <SummaryText text={null} meta={`Dotyczy: ${view.periodLabel}`} />}

    {view?.kind === "empty" && <p class="text-sm text-muted-foreground">Laboratorium jeszcze nic nie przesłało.</p>}
  </div>
</Panel>
