---
import { GLOSSARY, type GlossaryTerm } from "@/lib/format/glossary";

interface Props {
  terms: GlossaryTerm[];
}

// A native <details> works on a phone without any client-side script; py-1 keeps the summary's tap target
// at least 24px tall (WCAG 2.5.8).
const { terms } = Astro.props;
---

<details class="text-muted-foreground text-sm">
  <summary class="text-card-foreground cursor-pointer py-1">Co to znaczy?</summary>
  <dl class="mt-2 space-y-2">
    {terms.map((key) => (
      <div>
        <dt class="text-card-foreground font-medium">{GLOSSARY[key].term}</dt>
        <dd>{GLOSSARY[key].explanation}</dd>
      </div>
    ))}
  </dl>
</details>
