---
import { BatteryMedium, House, Sun, TowerControl } from "lucide-react";
import { cn } from "@/lib/utils";

const TONES = [
  { word: "Dobrze", dot: "bg-tone-good" },
  { word: "Warto sprawdzić", dot: "bg-tone-watch" },
  { word: "Problem", dot: "bg-tone-problem" },
];

const SOURCES = [
  { word: "Panele", Icon: Sun, color: "text-flow-pv" },
  { word: "Bateria", Icon: BatteryMedium, color: "text-flow-battery" },
  { word: "Dom", Icon: House, color: "text-flow-home" },
  { word: "Sieć", Icon: TowerControl, color: "text-flow-grid" },
];
---

<footer
  aria-label="Legenda"
  class="bg-card border-border text-card-foreground flex flex-col gap-3.5 rounded-2xl border px-[18px] py-4 text-[13px] sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6 sm:text-sm"
>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-x-[22px]">
    {TONES.map(({ word, dot }) => (
      <span class="inline-flex items-center gap-1.5 sm:gap-2">
        <span aria-hidden="true" class:list={cn("size-2.5 rounded-full", dot)} />
        {word}
      </span>
    ))}
  </div>
  <div class="flex flex-wrap items-center gap-x-[18px] gap-y-2 sm:gap-x-[26px]">
    {SOURCES.map(({ word, Icon, color }) => (
      <span class="inline-flex items-center gap-1.5 sm:gap-2">
        <Icon aria-hidden="true" className={cn("size-[18px] sm:size-5", color)} />
        {word}
      </span>
    ))}
  </div>
</footer>
