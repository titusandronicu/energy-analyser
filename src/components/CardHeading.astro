---
import type { LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  icon?: LucideIcon;
  iconClass?: string;
  // lg: the live card (22/28 px bold); lead: the recommendation (22 px semibold); md: the other cards (20 px).
  size?: "lg" | "lead" | "md";
  class?: string;
}

const SIZE_CLASS = {
  lg: "text-[22px] font-bold sm:text-[28px]",
  lead: "text-[22px] font-semibold",
  md: "text-xl font-semibold",
};

const { title, icon: Icon, iconClass, size = "md", class: className } = Astro.props;
---

<div class:list={cn("flex items-center gap-3", className)}>
  {Icon && <Icon aria-hidden="true" className={cn("size-[22px] shrink-0", iconClass)} />}
  <h2 class:list={cn("text-card-foreground", SIZE_CLASS[size])}>{title}</h2>
</div>
