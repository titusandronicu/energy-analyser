---
import Panel from "@/components/ui/Panel.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TermsExplained from "@/components/TermsExplained.astro";
import type { RecommendationView } from "@/lib/services/recommendation";

type Forecast = Extract<RecommendationView, { kind: "recommendation" }>["forecast"];

interface Props {
  forecast: Forecast | null;
  isFromEarlierDay: boolean;
}

// Relocated out of RecommendationCard (dashboard-glass-restyle) so the PV forecast and its confidence
// badge sit next to Zużycie wczoraj instead of buried inside the recommendation narrative.
const { forecast, isFromEarlierDay } = Astro.props;
---

{forecast && (
  <Panel>
    <h2 class="mb-2 text-lg font-semibold text-blue-100">Prognoza produkcji</h2>
    <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-blue-100/60">
          {isFromEarlierDay
            ? `Prognoza produkcji z paneli — ${forecast.todayDayLabel}`
            : `Prognoza produkcji z paneli — dziś (${forecast.todayDayLabel})`}
        </dt>
        <dd class="font-medium">{forecast.todayLabel}</dd>
      </div>
      <div>
        <dt class="text-blue-100/60">
          {isFromEarlierDay
            ? `Prognoza produkcji z paneli — ${forecast.tomorrowDayLabel}`
            : `Prognoza produkcji z paneli — jutro (${forecast.tomorrowDayLabel})`}
        </dt>
        <dd class="font-medium">{forecast.tomorrowLabel}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-blue-100/60">Pewność prognozy</dt>
        <dd class="mt-1">
          <StatusBadge status={forecast.certainty} testId="forecast-certainty" />
        </dd>
      </div>
    </dl>

    <TermsExplained terms={["forecast", "forecast_certainty", "kwh"]} />
  </Panel>
)}
