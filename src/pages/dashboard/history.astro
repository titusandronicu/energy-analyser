---
import AppShell from "@/components/AppShell.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import DayView from "@/components/history/DayView.astro";
import HistoryNotes from "@/components/history/HistoryNotes.astro";
import MonthView from "@/components/history/MonthView.astro";
import PeriodNav from "@/components/history/PeriodNav.astro";
import QuarterView from "@/components/history/QuarterView.astro";
import Panel from "@/components/ui/Panel.astro";
import Layout from "@/layouts/Layout.astro";
import { HISTORY_PATH, periodNav } from "@/lib/calendar/nav";
import { parsePeriod, periodBounds, periodInstants, periodLabel, type CalendarPeriod } from "@/lib/calendar/period";
import { LOAD_FAILED } from "@/lib/format/status";
import { warsawParts } from "@/lib/format/warsaw-time";
import { orLoadError, pageClient } from "@/lib/page-load";
import { loadDailyRange, loadRecommendationsForDay, loadRecommendationTimes } from "@/lib/services/calendar-data";
import {
  buildDayView,
  buildMonthView,
  buildQuarterView,
  defaultPeriodFromRows,
  defaultPeriodRange,
  ratedPeriodRange,
  type DayView as DayViewModel,
  type MonthView as MonthViewModel,
  type QuarterView as QuarterViewModel,
} from "@/lib/services/calendar-view";
import type { DailyEnergyRow } from "@/types";

// The history calendar (S-15): the period comes from the URL (?day=, ?month=, ?quarter=), only its rows are loaded
// (for a day or a month also the 14 days before it, which its rating's norm needs), and each section fails on its own. Past periods don't change every few minutes, so unlike the dashboard this page
// has no reload script.
const { user } = Astro.locals;

// Each section loads on its own (orLoadError) through one lazily created Supabase client for the page, as on the
// dashboard.
const getClient = pageClient(Astro.request.headers, Astro.cookies);

function dailyRange(from: string, to: string): Promise<DailyEnergyRow[] | null> {
  return orLoadError(async () => {
    const supabase = getClient();
    return supabase ? await loadDailyRange(supabase, from, to) : [];
  });
}

const now = new Date();
const today = warsawParts(now).dayKey;

type PageData =
  | { kind: "month"; period: CalendarPeriod; view: MonthViewModel | null; markersFailed: boolean }
  | {
      kind: "day";
      period: CalendarPeriod;
      view: DayViewModel | null;
      rowFailed: boolean;
      adviceFailed: boolean;
    }
  | { kind: "quarter"; period: CalendarPeriod; view: QuarterViewModel | null };

// Loads only the chosen period's rows, each section on its own.
async function loadPage(parsed: CalendarPeriod | "default"): Promise<PageData> {
  // No period in the URL: defaultPeriodFromRows picks the month. Its rows are loaded with the previous month's and the
  // norm days before it, so the chosen month needs no second read; if they fail, the current month is shown with its
  // load error.
  let period: CalendarPeriod;
  let preloaded: DailyEnergyRow[] | null | undefined;
  if (parsed === "default") {
    const range = defaultPeriodRange(today);
    preloaded = await dailyRange(range.first, range.last);
    period = preloaded === null ? { kind: "month", month: today.slice(0, 7) } : defaultPeriodFromRows(preloaded, today);
  } else {
    period = parsed;
  }

  const { first, last } = periodBounds(period);
  const { fromMs, toMs } = periodInstants(period);

  if (period.kind === "month") {
    const month = period.month;
    // The recommendation times are only read once the daily rows loaded: without them the month shows its load error
    // and has no grid to mark.
    const range = ratedPeriodRange(period);
    const rows = preloaded === undefined ? await dailyRange(range.first, range.last) : preloaded;
    if (rows === null) return { kind: "month", period, view: null, markersFailed: false };
    const times = await orLoadError(async () => {
      const supabase = getClient();
      return supabase ? await loadRecommendationTimes(supabase, fromMs, toMs) : { times: [], truncated: false };
    });
    const view = await orLoadError(async () =>
      Promise.resolve(buildMonthView(month, rows, times ?? { times: [], truncated: false }, today)),
    );
    return { kind: "month", period, view, markersFailed: times === null };
  }

  if (period.kind === "day") {
    const day = period.day;
    const range = ratedPeriodRange(period);
    const [rows, recs] = await Promise.all([
      dailyRange(range.first, range.last),
      orLoadError(async () => {
        const supabase = getClient();
        return supabase ? await loadRecommendationsForDay(supabase, fromMs, toMs) : [];
      }),
    ]);
    const view = await orLoadError(async () => Promise.resolve(buildDayView(day, rows ?? [], recs ?? [], today, now)));
    return { kind: "day", period, view, rowFailed: rows === null, adviceFailed: recs === null };
  }

  const { year, quarter } = period;
  const rows = await dailyRange(first, last);
  const view =
    rows === null ? null : await orLoadError(async () => Promise.resolve(buildQuarterView(year, quarter, rows, today)));
  return { kind: "quarter", period, view };
}

const parsed = parsePeriod(Astro.url.searchParams, today);
// A malformed, combined or out-of-range period redirects (302) to the default month: exactly the page's path, no
// query. It is set on Astro.response and nothing is rendered, because a top-level `return Astro.redirect()` in the
// frontmatter crashes typescript-eslint's no-misused-promises rule.
if (parsed === null) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", HISTORY_PATH);
}
const page = parsed === null ? null : await loadPage(parsed);
const nav = page === null ? null : periodNav(page.period, today);
---

{page !== null && nav !== null && (
  <Layout title={`Historia — ${periodLabel(page.period)}`}>
    <AppShell email={user?.email} current="history">
      <PeriodNav nav={nav} />

      {page.kind === "month" && <MonthView view={page.view} markersFailed={page.markersFailed} today={today} />}
      {page.kind === "day" &&
        (page.view === null ? (
          <Panel>
            <StatusBadge status={LOAD_FAILED} testId="history-day-status" />
            <p class="text-muted-foreground mt-2 text-sm">Spróbuj odświeżyć stronę.</p>
          </Panel>
        ) : (
          <DayView view={page.view} rowFailed={page.rowFailed} adviceFailed={page.adviceFailed} />
        ))}
      {page.kind === "quarter" && <QuarterView view={page.view} today={today} />}

      <Panel class="py-4">
        <HistoryNotes />
      </Panel>
    </AppShell>
  </Layout>
)}
