---
import Layout from "@/layouts/Layout.astro";
import DashboardBody from "@/components/DashboardBody.astro";
import { loadBillForecast, toBillForecastView, type BillForecastView } from "@/lib/services/bill-forecast";
import { warsawParts } from "@/lib/format/warsaw-time";
import { loadDailyRowCapturedAt, loadLiveState, toLiveStateView, type LiveStateView } from "@/lib/services/live-state";
import { loadHourlyEnergy, toHourlyUsageView, type HourlyUsageView } from "@/lib/services/hourly-usage";
import { loadLatestRecommendation, toRecommendationView, type RecommendationView } from "@/lib/services/recommendation";
import { loadTodaySummary, toTodaySummaryView, type TodaySummaryView } from "@/lib/services/period-summary";
import { loadDailyEnergy, toUsageInsightView, type UsageInsightView } from "@/lib/services/usage-insight";
import { orLoadError, pageClient } from "@/lib/page-load";

const { user } = Astro.locals;

// Each card loads on its own (orLoadError) through one lazily created Supabase client for the page.
const getClient = pageClient(Astro.request.headers, Astro.cookies);

const now = new Date();
// The daily rows feed both the usage card and the live verdicts, so they load once; a failure (null) shows the usage
// card's load error and leaves the live card's PV and consumption verdicts unrated.
const dailyRowsPromise = orLoadError(async () => {
  const supabase = getClient();
  return supabase ? await loadDailyEnergy(supabase, now) : [];
});
const [liveView, billView, usageView, view, todaySummary, hourlyView]: [
  LiveStateView | null,
  BillForecastView | null,
  UsageInsightView | null,
  RecommendationView | null,
  TodaySummaryView | null,
  HourlyUsageView | null,
] = await Promise.all([
  orLoadError(async () => {
    const supabase = getClient();
    const liveRow = supabase ? await loadLiveState(supabase) : null;
    // Own isolation: a failure (for example the column grant not applied yet) only leaves consumption unrated.
    const rowCapturedAt =
      supabase && liveRow
        ? await orLoadError(() => loadDailyRowCapturedAt(supabase, warsawParts(new Date(liveRow.captured_at)).dayKey))
        : null;
    return toLiveStateView(liveRow, now, await dailyRowsPromise, rowCapturedAt);
  }),
  orLoadError(async () => {
    const supabase = getClient();
    return toBillForecastView(supabase ? await loadBillForecast(supabase) : null, now);
  }),
  orLoadError(async () => {
    const dailyRows = await dailyRowsPromise;
    return dailyRows === null ? null : toUsageInsightView(dailyRows, now);
  }),
  orLoadError(async () => {
    const supabase = getClient();
    return toRecommendationView(supabase ? await loadLatestRecommendation(supabase) : null, now);
  }),
  orLoadError(async () => {
    const supabase = getClient();
    return toTodaySummaryView(supabase ? await loadTodaySummary(supabase) : null, now);
  }),
  orLoadError(async () => {
    const supabase = getClient();
    return toHourlyUsageView(supabase ? await loadHourlyEnergy(supabase, now) : [], now);
  }),
]);
---

<Layout title="Energy Analyser">
  <DashboardBody
    liveView={liveView}
    billView={billView}
    usageView={usageView}
    recommendationView={view}
    todaySummary={todaySummary}
    hourlyView={hourlyView}
    email={user?.email}
  />
</Layout>

<script>
  // Reload every 5 minutes so new data and staleness show up in an open tab; background tabs never reload.
  const RELOAD_AFTER_MS = 5 * 60 * 1000;
  const loadedAt = Date.now();

  function reloadIfDue() {
    if (document.visibilityState === "visible" && Date.now() - loadedAt >= RELOAD_AFTER_MS) {
      window.location.reload();
    }
  }

  // Check every minute rather than once, so a timer firing a moment early can't skip the reload for good.
  setInterval(reloadIfDue, 60 * 1000);
  document.addEventListener("visibilitychange", reloadIfDue);
</script>
