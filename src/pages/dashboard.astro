---
import Layout from "@/layouts/Layout.astro";
import LiveStateCard from "@/components/LiveStateCard.astro";
import RecommendationCard from "@/components/RecommendationCard.astro";
import UsageInsightCard from "@/components/UsageInsightCard.astro";
import { loadLiveState, toLiveStateView, type LiveStateView } from "@/lib/services/live-state";
import { loadLatestRecommendation, toRecommendationView, type RecommendationView } from "@/lib/services/recommendation";
import { loadDailyEnergy, toUsageInsightView, type UsageInsightView } from "@/lib/services/usage-insight";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// Each card loads on its own: a failure shows that card's load error (null) and leaves the others intact.
async function orLoadError<T>(load: () => Promise<T>): Promise<T | null> {
  try {
    return await load();
  } catch (error) {
    // eslint-disable-next-line no-console -- server-side detail; the page shows a generic load error
    console.error(error);
    return null;
  }
}

const now = new Date();
const [liveView, usageView, view]: [LiveStateView | null, UsageInsightView | null, RecommendationView | null] =
  await Promise.all([
    orLoadError(async () => {
      const supabase = createClient(Astro.request.headers, Astro.cookies);
      return toLiveStateView(supabase ? await loadLiveState(supabase) : null, now);
    }),
    orLoadError(async () => {
      const supabase = createClient(Astro.request.headers, Astro.cookies);
      return toUsageInsightView(supabase ? await loadDailyEnergy(supabase, now) : [], now);
    }),
    orLoadError(async () => {
      const supabase = createClient(Astro.request.headers, Astro.cookies);
      return toRecommendationView(supabase ? await loadLatestRecommendation(supabase) : null, now);
    }),
  ]);
---

<Layout title="Energy Analyser">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl space-y-6">
      <header class="flex items-center justify-between text-sm text-blue-100/70">
        <span class="font-semibold text-white">Energy Analyser</span>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline">{user?.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Wyloguj
            </button>
          </form>
        </div>
      </header>

      <LiveStateCard view={liveView} />
      <UsageInsightCard view={usageView} />
      <RecommendationCard view={view} />
    </div>
  </div>
</Layout>

<script>
  // Reload every 5 minutes so new data and staleness show up in an open tab; background tabs never reload.
  const RELOAD_AFTER_MS = 5 * 60 * 1000;
  const loadedAt = Date.now();

  function reloadIfDue() {
    if (document.visibilityState === "visible" && Date.now() - loadedAt >= RELOAD_AFTER_MS) {
      window.location.reload();
    }
  }

  // Check every minute rather than once, so a timer firing a moment early can't skip the reload for good.
  setInterval(reloadIfDue, 60 * 1000);
  document.addEventListener("visibilitychange", reloadIfDue);
</script>
