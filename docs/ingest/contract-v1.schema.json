{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "homelab"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "state": {
      "type": "object",
      "properties": {
        "pv_w": {
          "type": ["number", "null"]
        },
        "home_load_w": {
          "type": ["number", "null"]
        },
        "grid_w": {
          "type": ["number", "null"]
        },
        "battery_w": {
          "type": ["number", "null"]
        },
        "battery_soc_pct": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "pv_today_kwh": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "grid_import_today_kwh": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "grid_export_today_kwh": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_health": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 50
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pv_w",
        "home_load_w",
        "grid_w",
        "battery_w",
        "battery_soc_pct",
        "pv_today_kwh",
        "grid_import_today_kwh",
        "grid_export_today_kwh",
        "source_health"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "language": {
          "type": "string",
          "const": "pl"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "provider": {
          "type": "string",
          "enum": ["ha_conversation", "ollama", "openrouter"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "forecast": {
          "type": "object",
          "properties": {
            "today_kwh": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "tomorrow_kwh": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "required": ["today_kwh", "tomorrow_kwh"],
          "additionalProperties": false
        },
        "facts": {
          "type": "object",
          "properties": {
            "current_state": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 100
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "balance_today": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 100
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "local_findings": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 100
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "sanity_checks": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 100
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "required": ["current_state", "balance_today", "local_findings", "sanity_checks"],
          "additionalProperties": false
        }
      },
      "required": ["generated_at", "language", "text", "provider", "model", "forecast", "facts"],
      "additionalProperties": false
    },
    "daily_history": {
      "maxItems": 62,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "pv_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "load_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "grid_import_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "grid_export_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "pv_forecast_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["day", "pv_kwh", "load_kwh", "grid_import_kwh", "grid_export_kwh"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contract_version", "source", "captured_at", "state"],
  "additionalProperties": false
}
