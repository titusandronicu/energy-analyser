+/** Restricts `value` to the inclusive range [min, max]. Throws if the range is inverted. */
+export function clamp(value: number, min: number, max: number): number {
+  if (min > max) {
+    throw new RangeError(`clamp: min (${String(min)}) must not exceed max (${String(max)})`);
+  }
+  return Math.min(max, Math.max(min, value));
+}
diff --git a/src/lib/clamp.test.ts b/src/lib/clamp.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/clamp.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from "vitest";
+import { clamp } from "./clamp";
+
+describe("clamp", () => {
+  it("returns the value when it is inside the range", () => {
+    expect(clamp(5, 0, 10)).toBe(5);
+  });
+  it("limits values below min and above max", () => {
+    expect(clamp(-3, 0, 10)).toBe(0);
+    expect(clamp(42, 0, 10)).toBe(10);
+  });
+  it("accepts the boundaries", () => {
+    expect(clamp(0, 0, 10)).toBe(0);
+    expect(clamp(10, 0, 10)).toBe(10);
+  });
+  it("throws for an inverted range", () => {
+    expect(() => clamp(1, 10, 0)).toThrow(RangeError);
+  });
+});
