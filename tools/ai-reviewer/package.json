{
  "name": "ai-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team code-review agent: AI SDK 7 ToolLoopAgent + GitHub Actions composite action",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "review": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=../../.github/actions/ai-reviewer/dist/review.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "eval": "promptfoo eval"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "promptfoo": "^0.124.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
