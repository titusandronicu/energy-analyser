SUPABASE_URL=###
SUPABASE_ANON_KEY=###
# true only locally/CI: lets a sign-in link request create a new user
ALLOW_SIGNUP=false
APP_VERSION=development
# tags every log line; compose.yaml sets production
APP_ENV=development
APP_ORIGIN=http://localhost:4321
# Alert notifications (POST /api/alerts/evaluate): the dedicated bot's token and the chat id to write to. Without both
# the route answers 503 and records nothing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HOST=::
